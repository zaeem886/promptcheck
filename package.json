{
  "name": "promptprivacy",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "evaluate": "node --expose-gc scripts/evaluate.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "package": "node scripts/package.mjs",
    "check": "npm run build && npm test && npm run evaluate && npm run test:browser"
  },
  "dependencies": {
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.1"
  }
}
